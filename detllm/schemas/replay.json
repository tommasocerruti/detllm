{
  "description": "Stable schema. Only additive changes within the same major version.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "detLLM Replay",
  "type": "object",
  "required": [
    "schema_version",
    "detllm_version",
    "artifact_type",
    "status",
    "executed_probes",
    "skipped_probes"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "detllm_version": {"type": "string"},
    "artifact_type": {"const": "replay"},
    "status": {"type": "string"},
    "executed_probes": {"type": "array", "items": {"type": "string"}},
    "skipped_probes": {"type": "array", "items": {"type": "object"}}
  },
  "additionalProperties": true
}
