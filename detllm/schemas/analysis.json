{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "detllm_version",
    "artifact_type",
    "summary",
    "intervals",
    "risk_score",
    "recommendations",
    "cells"
  ],
  "properties": {
    "schema_version": {"type": "string"},
    "detllm_version": {"type": "string"},
    "artifact_type": {"const": "analysis"},
    "summary": {"type": "object"},
    "intervals": {"type": "object"},
    "risk_score": {"type": ["number", "null"]},
    "recommendations": {
      "type": "array",
      "items": {"type": "object"}
    },
    "cells": {
      "type": "array",
      "items": {"type": "object"}
    }
  },
  "additionalProperties": true
}
